#!/usr/bin/env bash

set -euo pipefail

if ! command -v pwsh >/dev/null 2>&1; then
  echo "workflow-kit requires pwsh on PATH" >&2
  exit 1
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
exec pwsh -NoLogo -NoProfile -File "$SCRIPT_DIR/../workflow-kit.ps1" -RepoRoot "$PWD" "$@"
